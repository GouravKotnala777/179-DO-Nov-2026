- name: deploy serverless Lambda function
  hosts: localhost
  tasks:
    - name: create Lambda function
      command: aws lambda create-function --function-name gourav-lambda --runtime nodejs14.x --role arn:aws:iam::1238137182712012:role/lambda-role --handler index.handler --zip-file fileb://lambda.zip





resource "aws_dynamodb_table" "gourav_table" {
  name           = "gourav-table"
  hash_key       = "id"
  billing_mode   = "PAY_PER_REQUEST"
  attribute {
    name = "id"
    type = "S"
  }
}






apiVersion: kubeless.io/v1beta1
kind: Function
metadata:
  name: gourav-lambda
  namespace: default
spec:
  runtime: nodejs14
  handler: index.handler
  function: |
    module.exports = function(event, context) {
      context.succeed("my name is gourav");
    };






pipeline {
    agent any
    stages {
        stage('Build') {
            steps {
                echo 'building Lambda function package...'
                sh 'zip -r lambda.zip lambda/'
            }
        }
        stage('deploy to Lambda') {
            steps {
                script {
                    sh 'aws lambda update-function-code --function-name gourav-lambda --zip-file fileb://lambda.zip'
                }
            }
        }
    }
}





